<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: surface with a soft mint tint from the top corner and a hairline outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_surface"
        android:startColor="@color/widget_surface_tint"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
